---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import sorteos from '../data/sorteos.json';
import site from '../data/site.json';
import { withBase } from '../utils/url';

const activos = sorteos.filter((s) => s.activo);
---

<BaseLayout title="Sorteos" description="Participá en los sorteos de Bonus Playpark. Premios, packs familiares y más.">
  <Header slot="header" />

  <Hero
    title="Sorteos Bonus"
    subtitle="Participá y ganá premios increíbles. Seguinos en redes para no perderte ninguno."
    compact
  />

  <section class="section-padding">
    <div class="container-site">
      {
        activos.length > 0 ? (
          <>
            <SectionHeading title="Sorteos activos" accent="yellow" />
            <div class="grid gap-8 lg:grid-cols-2">
              {activos.map((s) => (
                <article class="card-sticker overflow-hidden">
                  <img src={s.imagen} alt={s.titulo} class="aspect-video w-full object-cover" loading="lazy" />
                  <div class="p-6">
                    <span class="inline-block rounded-full bg-accent-yellow px-3 py-1 text-xs font-bold uppercase text-gray-900">
                      Hasta {s.fechaFin}
                    </span>
                    <h3 class="mt-3 font-display text-2xl font-bold text-primary">{s.titulo}</h3>
                    <p class="mt-2 text-gray-600">{s.descripcion}</p>
                    <h4 class="mt-4 font-semibold text-gray-800">Bases y condiciones:</h4>
                    <ul class="mt-2 space-y-1 text-sm text-gray-600">
                      {s.bases.map((b) => (
                        <li class="flex items-start gap-2">
                          <span class="text-accent-orange">•</span>
                          {b}
                        </li>
                      ))}
                    </ul>
                    <div class="mt-6 flex flex-wrap gap-3">
                      <a href={site.social.instagram} target="_blank" rel="noopener noreferrer" class="btn btn-primary text-sm">
                        Participá en Instagram
                      </a>
                      <a href={withBase('/contacto')} class="btn btn-outline text-sm">
                        Consultar por contacto
                      </a>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </>
        ) : (
          <div class="card-sticker mx-auto max-w-xl p-10 text-center">
            <div class="text-5xl">🎁</div>
            <h2 class="mt-4 font-display text-2xl font-bold text-primary">Próximamente</h2>
            <p class="mt-2 text-gray-600">
              Estamos preparando nuevos sorteos. Seguinos en redes para enterarte primero.
            </p>
            <a href={site.social.instagram} target="_blank" rel="noopener noreferrer" class="btn btn-primary mt-6">
              Seguir @bonusplaypark
            </a>
          </div>
        )
      }
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
