---
interface Props {
  title: string;
  subtitle?: string;
  compact?: boolean;
}

const { title, subtitle, compact = false } = Astro.props;
---

<section
  class:list={[
    'relative overflow-hidden bg-primary text-white',
    compact ? 'py-16' : 'py-24 sm:py-32',
  ]}
>
  <div class="absolute inset-0 opacity-20">
    <div class="absolute -left-20 -top-20 h-64 w-64 rounded-full bg-accent-blue blur-3xl"></div>
    <div class="absolute -bottom-20 -right-20 h-64 w-64 rounded-full bg-accent-orange blur-3xl"></div>
    <div class="absolute left-1/2 top-1/2 h-48 w-48 -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent-yellow blur-3xl"></div>
  </div>

  <div class="container-site relative px-4 text-center sm:px-6 lg:px-8">
    <h1 class="font-display text-4xl font-bold sm:text-5xl lg:text-6xl">{title}</h1>
    {subtitle && <p class="mx-auto mt-6 max-w-2xl text-lg text-white/90 sm:text-xl">{subtitle}</p>}
    <slot />
  </div>
</section>
