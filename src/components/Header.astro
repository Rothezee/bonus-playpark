---
import site from '../data/site.json';
import { isActiveLink, withBase } from '../utils/url';

const currentPath = Astro.url.pathname;
const logoUrl = withBase('logo.png');
---

<header class="sticky top-0 z-50 bg-primary shadow-lg">
  <div class="container-site flex items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
    <a href={withBase('/')} class="flex shrink-0 items-center gap-3 rounded-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-primary">
      <img src={logoUrl} alt={site.name} class="h-12 w-12 rounded-full border-2 border-white sm:h-14 sm:w-14" />
      <span class="hidden font-display text-lg font-semibold text-white sm:block">{site.name}</span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Navegación principal">
      {
        site.nav.map((item) => (
          <a
            href={withBase(item.href)}
            class:list={[
              'rounded-full px-4 py-2 text-sm font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white',
              item.highlight
                ? 'bg-accent-green text-white hover:brightness-110'
                : isActiveLink(item.href, currentPath)
                  ? 'bg-white/20 text-white'
                  : 'text-white/90 hover:bg-white/10 hover:text-white',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a href={withBase('/contacto')} class="btn btn-secondary ml-2 text-sm">Contacto</a>
    </nav>

    <button
      id="mobile-menu-btn"
      type="button"
      class="rounded-xl p-2 text-white hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú"
    >
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <nav
    id="mobile-menu"
    class="hidden border-t border-white/20 bg-primary-dark lg:hidden"
    aria-label="Menú mobile"
  >
    <div class="container-site flex flex-col gap-1 px-4 py-4">
      {
        site.nav.map((item) => (
          <a
            href={withBase(item.href)}
            class:list={[
              'rounded-xl px-4 py-3 font-semibold transition-colors',
              item.highlight
                ? 'bg-accent-green text-white'
                : isActiveLink(item.href, currentPath)
                  ? 'bg-white/20 text-white'
                  : 'text-white/90 hover:bg-white/10',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a href={withBase('/contacto')} class="btn btn-secondary mt-2 w-full">Contacto</a>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    btn.setAttribute('aria-expanded', String(!isOpen));
    btn.setAttribute('aria-label', isOpen ? 'Abrir menú' : 'Cerrar menú');
  });
</script>
