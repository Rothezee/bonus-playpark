---
import site from '../data/site.json';

const whatsappUrl = `https://wa.me/${site.whatsapp.replace(/\D/g, '')}?text=${encodeURIComponent(site.whatsappMessage)}`;
const formAction = site.formspreeContact || undefined;

const motivos = [
  'Consulta general',
  'Precios y tarjetas',
  'Cumpleaños y eventos',
  'Sorteos',
  'Franquicias',
  'Otro',
];
---

<form
  action={formAction}
  method="POST"
  class="card-sticker p-6 sm:p-8"
  id="contact-form"
>
  <h3 class="font-display text-2xl font-bold text-primary">Envianos un mensaje</h3>

  <div class="mt-6 space-y-4">
    <div>
      <label for="contact-name" class="mb-1 block text-sm font-semibold text-gray-700">Nombre</label>
      <input
        type="text"
        id="contact-name"
        name="nombre"
        required
        class="w-full rounded-xl border-2 border-gray-200 px-4 py-3 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
      />
    </div>

    <div>
      <label for="contact-email" class="mb-1 block text-sm font-semibold text-gray-700">Email</label>
      <input
        type="email"
        id="contact-email"
        name="email"
        required
        class="w-full rounded-xl border-2 border-gray-200 px-4 py-3 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
      />
    </div>

    <div>
      <label for="contact-whatsapp" class="mb-1 block text-sm font-semibold text-gray-700">WhatsApp</label>
      <input
        type="tel"
        id="contact-whatsapp"
        name="whatsapp"
        class="w-full rounded-xl border-2 border-gray-200 px-4 py-3 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
      />
    </div>

    <div>
      <label for="contact-motivo" class="mb-1 block text-sm font-semibold text-gray-700">Motivo de tu contacto</label>
      <select
        id="contact-motivo"
        name="motivo"
        required
        class="w-full rounded-xl border-2 border-gray-200 px-4 py-3 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
      >
        <option value="">Seleccioná un motivo</option>
        {
          motivos.map((m) => (
            <option value={m}>{m}</option>
          ))
        }
      </select>
    </div>

    <div>
      <label for="contact-message" class="mb-1 block text-sm font-semibold text-gray-700">Mensaje</label>
      <textarea
        id="contact-message"
        name="mensaje"
        rows="4"
        required
        class="w-full rounded-xl border-2 border-gray-200 px-4 py-3 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
      ></textarea>
    </div>
  </div>

  <button type="submit" class="btn btn-primary mt-6 w-full">Enviar mensaje</button>
</form>

<script define:vars={{ whatsappUrl, formAction }}>
  const form = document.getElementById('contact-form');
  form?.addEventListener('submit', (e) => {
    if (formAction) return;
    e.preventDefault();
    const data = new FormData(form);
    const msg = [
      `Consulta Bonus Playpark - ${data.get('motivo')}`,
      '',
      `Nombre: ${data.get('nombre')}`,
      `Email: ${data.get('email')}`,
      data.get('whatsapp') ? `WhatsApp: ${data.get('whatsapp')}` : '',
      '',
      String(data.get('mensaje')),
    ]
      .filter(Boolean)
      .join('\n');
    window.open(`${whatsappUrl.split('?')[0]}?text=${encodeURIComponent(msg)}`, '_blank');
  });
</script>
